{
  "name": "multai",
  "version": "0.0.0-dev.1",
  "private": true,
  "description": "Fresh MultAI desktop collaboration backend",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24.0.0 <25"},
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @multai/backend",
    "db:migrate": "npm run migrate --workspace @multai/backend",
    "test:integration": "node scripts/test-postgres.mjs"
  },
  "devDependencies": {"typescript": "7.0.2", "tsx": "4.23.15", "@types/node": "24.19.2"}
}
