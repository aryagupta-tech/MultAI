{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2
		max_header_size 32KB
	}
	# Access logging stays disabled. Sanitize runtime errors that carry a request.
	log {
		level WARN
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				uri delete
				url delete
			}
		}
	}
}

{$COLLABORATION_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		# Screenshot routes accept up to 120,000 bytes; the API keeps its per-route limits.
		max_size 128KB
	}
	reverse_proxy backend:4310 {
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 20s
		}
	}
}

# The short address for the browser companion. It forwards to the companion on the collaboration
# domain, which owns sign-in, cookies and the API; an invitation code after # carries over.
{$COMPANION_DOMAIN:app.multai.si} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	redir https://{$COLLABORATION_DOMAIN}/app{uri} 308
}

http://127.0.0.1:9080 {
	bind 127.0.0.1
	respond /health/proxy "ok" 200
}
