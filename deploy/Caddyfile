{
	admin off
	persist_config off
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2
		max_header_size 32KB
	}
	# Access logging stays disabled. Sanitize runtime errors that carry a request.
	log {
		level WARN
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				uri delete
				url delete
			}
		}
	}
}

{$COLLABORATION_DOMAIN} {
	# Verified Android invitations keep their API URL; browsers follow this to the web app.
	# Legacy OAuth completion and its assets stay on their original origin for in-flight PKCE.
	@companionPage {
		method GET HEAD
		path /app /app/*
		not path /app/auth /app/assets/* /app/downloads/* /app/sw.js /app/manifest.webmanifest /app/favicon.svg /app/icon-192.png /app/icon-512.png /app/apple-touch-icon.png
	}
	redir @companionPage https://{$COMPANION_DOMAIN:app.multai.si}{uri} 302
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		# Screenshot routes accept up to 120,000 bytes; the API keeps its per-route limits.
		max_size 128KB
	}
	reverse_proxy backend:4310 {
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 20s
		}
	}
}

# The browser owns host-only sign-in/controller cookies here. Relative API calls remain same-origin.
{$COMPANION_DOMAIN:app.multai.si} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	@home path /
	redir @home /app/ 302
	request_body {
		max_size 128KB
	}
	reverse_proxy backend:4310 {
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 20s
		}
	}
}

http://127.0.0.1:9080 {
	bind 127.0.0.1
	respond /health/proxy "ok" 200
}
