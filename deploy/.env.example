# Deployment plan only. Fill these after approving resources and recurring costs.
RESOURCE_ID=<new-lowercase-resource-id>
COLLABORATION_DOMAIN=<new-collaboration-domain>
ACME_EMAIL=<owner-selected-email>
SECRETS_DIRECTORY=/etc/multai/secrets
BACKEND_IMAGE=multai-backend:<reviewed-source-commit>
PROXY_IMAGE=multai-proxy:<reviewed-source-commit>
DATABASE_IMAGE=multai-database:<reviewed-source-commit>
SOURCE_COMMIT=<full-reviewed-40-character-source-commit>
SOURCE_DIRTY=false
AWS_REGION=ap-south-1
# Optional backup operator environment, not service container credentials:
# BACKUP_BUCKET=<new-private-lightsail-bucket>
# AGE_RECIPIENT=<new-age-public-recipient>
