{
  "name": "@multai/backend",
  "version": "0.0.0-dev.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/package-backend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate-cli.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "jose": "6.2.13",
    "zod": "4.6.7",
    "@fastify/websocket": "11.3.4",
    "@fastify/rate-limit": "11.2.1"
  },
  "devDependencies": {"@types/pg": "8.23.1", "@types/ws": "8.18.2", "ws": "8.22.0"}
}
